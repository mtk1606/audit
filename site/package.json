{
  "name": "as-audit-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "evidence": "node scripts/extract-evidence.mjs",
    "dev": "npm run evidence && vite",
    "build": "npm run evidence && node scripts/check-claims.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "single": "node scripts/single-file.mjs",
    "check": "node scripts/check-claims.mjs",
    "og": "node scripts/og.mjs",
    "build:release": "REQUIRE_SITE_URL=1 npm run build"
  },
  "devDependencies": {
    "playwright-core": "1.56.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/ibm-plex-sans": "5.1.1",
    "@fontsource/source-serif-4": "5.1.1"
  }
}
